# En local dejar DEBUG=True. En el servidor de producción, ponerlo en
# False -- nunca despliegues con DEBUG=True, expone información interna.
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-secreta
DATABASE_URL=sqlite:///db.sqlite3
# En producción (Railway), al agregar el plugin de PostgreSQL, ellos
# inyectan automáticamente DATABASE_URL con el formato:
# postgresql://usuario:password@host:puerto/nombre_db
# No hace falta configurarla a mano ahí, Railway la pone sola.
NEWS_API_KEY=tu-api-key-aqui
# Dominios adicionales permitidos, separados por coma (dsminds.com y
# www.dsminds.com ya están incluidos por defecto en settings.py).
ALLOWED_HOSTS=
